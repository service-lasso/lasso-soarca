{
  "id": "soarca",
  "name": "SOARCA",
  "description": "Release-backed SOARCA CACAO orchestration API service.",
  "version": "1.1.0",
  "enabled": false,
  "endpoints": [
    {
      "id": "api",
      "kind": "network",
      "label": "SOARCA API",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 8080,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "api_url",
      "kind": "url",
      "label": "SOARCA API",
      "target": "api",
      "url": "http://127.0.0.1:${endpoint.api.port}",
      "exposure": "local",
      "primary": true
    },
    {
      "id": "swagger",
      "kind": "url",
      "label": "Swagger",
      "target": "api",
      "url": "http://127.0.0.1:${endpoint.api.port}/swagger/index.html",
      "exposure": "local"
    },
    {
      "id": "health",
      "kind": "url",
      "label": "health",
      "target": "api",
      "url": "http://127.0.0.1:${endpoint.api.port}/status/ping",
      "exposure": "local"
    }
  ],
  "env": {
    "PORT": "${endpoint.api.port}",
    "GIN_MODE": "release",
    "SOARCA_ALLOWED_ORIGINS": "*",
    "MAX_EXECUTIONS": "1000",
    "MAX_REPORTERS": "5",
    "DATABASE": "false",
    "DATABASE_NAME": "soarca",
    "MONGODB_URI": "mongodb://127.0.0.1:27017",
    "DB_USERNAME": "root",
    "DB_PASSWORD": "rootpassword",
    "ENABLE_TLS": "false",
    "ENABLE_FINS": "false",
    "MQTT_BROKER": "127.0.0.1",
    "MQTT_PORT": "1883",
    "AUTH_ENABLED": "false",
    "LOG_GLOBAL_LEVEL": "info",
    "LOG_MODE": "production",
    "LOG_FORMAT": "json",
    "LOG_FILE_PATH": "${SERVICE_ROOT}/logs/soarca.log",
    "SOARCA_URL": "${endpoint.api_url.url}"
  },
  "globalenv": {
    "SOARCA_URL": "${SOARCA_URL}",
    "SOARCA_PORT": "${endpoint.api.port}",
    "SOARCA_SWAGGER_URL": "${endpoint.swagger.url}"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-soarca",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-soarca-1.1.0-win32.zip",
        "archiveType": "zip",
        "command": "./SOARCA.exe",
        "args": []
      },
      "linux": {
        "assetName": "lasso-soarca-1.1.0-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./SOARCA",
        "args": []
      },
      "darwin": {
        "assetName": "lasso-soarca-1.1.0-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./SOARCA",
        "args": []
      }
    }
  },
  "install": {
    "files": [
      {
        "path": "./logs/.keep",
        "content": ""
      },
      {
        "path": "./runtime/.keep",
        "content": ""
      }
    ]
  },
  "healthchecks": [
    {
      "id": "http-health",
      "type": "http",
      "url": "${endpoint.health.url}",
      "expected_status": 200,
      "retries": 80,
      "interval": 250
    }
  ],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  },
  "meta": {
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-soarca.git"
    },
    "documentationUrl": "https://github.com/service-lasso/lasso-soarca/blob/develop/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-soarca/issues",
    "upstreamUrl": "https://github.com/COSSAS/SOARCA",
    "tags": [
      "service-lasso",
      "soarca",
      "cacao",
      "orchestration",
      "soar"
    ]
  }
}
